{
    "problemMatcher": [
        {
            "owner": "clang",
            "pattern": [
                {
                    "regexp": "^(.+):(\\d+):(\\d+):\\s+(error|warning|note):\\s+(.+)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "code": 5
                },
                {
                    "regexp": "^\\s*(\\d*)\\s*\\|(.*)$",
                    "loop": true,
                    "message": 2
                }
            ]
        }
    ]
}
